<%- include('partials/header') %>
<h3>Personas registradas</h3>
<table class="table table-striped">
  <thead><tr><th>DNI</th><th>Nombre</th><th>Fecha Nac.</th><th>Género</th><th>Ciudad</th><th>Acciones</th></tr></thead>
  <tbody>
    <% if (personas.length === 0) { %>
      <tr><td colspan="6">No hay registros</td></tr>
    <% } %>
    <% personas.forEach(p => { %>
      <tr>
        <td><%= p.dni %></td>
        <td><%= p.nombres %> <%= p.apellidos %></td>
        <td><%= p.fechaNacimiento %></td>
        <td><%= p.genero %></td>
        <td><%= p.ciudad %></td>
        <td>
          <a class="btn btn-sm btn-outline-secondary" href="/personas/<%= p.id %>/edit">Editar</a>
          <form action="/personas/<%= p.id %>?_method=DELETE" method="POST" style="display:inline">
            <button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar?')">Borrar</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/footer') %>
